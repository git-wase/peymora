# Public site URL, no trailing slash. Used in confirmation links and metadata.
SITE_URL=http://localhost:3000

# Supabase — production database. Use the service role key on the server only.
# Never prefix it with NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — double opt-in and the short confirmation receipt.
# RESEND_FROM must be a sender on a domain you have verified in Resend.
RESEND_API_KEY=
RESEND_FROM="Vela <updates@yourdomain.com>"

# Cloudflare Turnstile. The site key is public. The secret stays on the server.
# Production refuses signups when the secret is missing. Local development with
# USE_LOCAL_STORE=true skips the check only when the secret is unset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Required to download subscribers as CSV.
# curl -H "Authorization: Bearer $ADMIN_EXPORT_SECRET" https://yourdomain.com/api/export
ADMIN_EXPORT_SECRET=

# Required for the daily cleanup of unconfirmed addresses older than 30 days.
# On Vercel, a cron job calls /api/cron/cleanup with this value as a bearer token.
CRON_SECRET=

# Local development only. Saves subscribers to data/subscribers.json.
# Ignored on Vercel, where the filesystem is not durable.
USE_LOCAL_STORE=true

# Plausible. Leave the script URL as-is so page views can include the message variant.
# Create the site in Plausible, then set the domain (no https://).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.manual.tagged-events.js
